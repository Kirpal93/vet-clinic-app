# Copy to .env.local (do not commit .env.local — it stays on your machine only).

# Required: Resend → API Keys → Create API Key
RESEND_API_KEY=re_paste_your_real_key_here

# Required: inbox that receives appointment emails.
# IMPORTANT: While using the default test sender (onboarding@resend.dev), Resend only delivers
# to the exact email address tied to your Resend account. Set CLINIC_EMAIL to that same address.
CLINIC_EMAIL=you@example.com

# Optional: after you verify your own domain in Resend, set a sender on that domain, e.g.:
# RESEND_FROM=PawCare <noreply@yourdomain.com>
# Do NOT use Gmail/Yahoo as "from" — Resend will reject it unless the domain is verified there.

# Development only: force skipping Resend (same as auto-fallback when the network blocks Resend).
# RESEND_DEV_MOCK=1

# Corporate proxy / SSL inspection: if Node fails HTTPS with "self-signed certificate in certificate chain",
# ask IT for the root CA file and point Node to it (then restart the dev server):
# NODE_EXTRA_CA_CERTS=C:\path\to\company-root-ca.pem
